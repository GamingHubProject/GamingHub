<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Both <env force="true"> AND matching <server> entries are required
            here, not just one. docker-compose.yml's app/scheduler services now
            use env_file: .env (see APP_KEY fix), so real .env values
            (APP_ENV=local, DB_DATABASE=gaming_hub, SESSION_DRIVER=database,
            CACHE_STORE=database, etc.) are genuine OS env vars by the time PHP
            starts — the CLI SAPI populates $_SERVER from them before PHPUnit
            ever runs. PHPUnit's force="true" on <env> only rewrites
            getenv()/$_ENV, not $_SERVER (see PhpHandler::handleEnvVariables).
            Laravel's Env repository checks $_SERVER with higher priority than
            getenv()/$_ENV, so without the <server> entries below it silently
            read back the real dev values (e.g. app()->environment() stayed
            "local", which made runningUnitTests() false and broke CSRF/session
            handling in every test that posts a form).
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <!-- Themes are folders on the assets disk, and the migration creates one:
             without this the suite writes into storage/app/public on every run. -->
        <env name="ASSETS_DISK" value="testing-assets" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="postgres" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="gaming_hub_test" force="true"/>
        <env name="DB_USERNAME" value="gaming_hub" force="true"/>
        <env name="DB_PASSWORD" value="secret" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>

        <server name="APP_ENV" value="testing"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="pgsql"/>
        <server name="DB_HOST" value="postgres"/>
        <server name="DB_PORT" value="5432"/>
        <server name="DB_DATABASE" value="gaming_hub_test"/>
        <server name="DB_USERNAME" value="gaming_hub"/>
        <server name="DB_PASSWORD" value="secret"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="PULSE_ENABLED" value="false"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
