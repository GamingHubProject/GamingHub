# Self-contained production image: dependencies and built assets are baked in
# at build time, so the container needs nothing but env vars to run — no bind
# mount, no manual `composer install` / `npm run build` step after deploy.

FROM php:8.4-cli AS base

# libjpeg-dev/libwebp-dev must be present *before* `docker-php-ext-install
# gd` runs — GD's configure step only picks up JPEG/WebP support if their
# dev headers are already on disk at that point; missing them here doesn't
# fail the build, it silently produces a GD that can't decode either
# format (confirmed live via gd_info() and a real upload's exception:
# "imagecreatefromstring(): No JPEG/WEBP support in this PHP build" —
# libpng-dev alone was only ever enough for PNG).
RUN apt-get update && apt-get install -y \
        git curl libpng-dev libjpeg-dev libwebp-dev libonig-dev libxml2-dev libzip-dev libpq-dev libicu-dev zip unzip \
        nodejs npm \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install pdo pdo_pgsql mbstring exif pcntl bcmath gd zip intl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

FROM base AS build

WORKDIR /app

# Dependency manifests only, before the rest of the source — these three
# install layers are then only invalidated when a lockfile actually
# changes, not on every commit. Confirmed this was the real cost behind
# a 10+ minute production build: resolving/downloading ~100 composer
# packages and ~200 npm packages (root + spa, including the whole
# React/Vite/TypeScript toolchain) from scratch on every single build,
# since the old "COPY . . " before any install step meant Docker's cache
# saw a changed input (the entire tree) and reinstalled everything
# regardless of whether a dependency had actually changed.
COPY composer.json composer.lock ./
RUN composer config -g policy.advisories.block false \
    && composer install --no-dev --no-interaction --no-scripts --no-autoloader

COPY package.json package-lock.json ./
RUN npm ci

COPY spa/package.json spa/package-lock.json ./spa/
RUN cd spa && npm ci

# Composer's post-autoload-dump scripts (artisan package:discover,
# filament:upgrade) need the real application tree to run, which is why
# they're deferred to here via dump-autoload rather than run inside the
# cached install above.
COPY . .
RUN composer dump-autoload --optimize

RUN npm run build

# Builds into ../resources/spa-dist (see spa/vite.config.ts) — a separate
# project from the root npm build above, with its own dependencies and its
# own production-only API base URL (spa/.env.production). routes/web.php
# serves it explicitly from there, deliberately outside public/.
RUN cd spa && npm run build

FROM base AS runtime

WORKDIR /app
COPY --from=build /app ./
RUN rm -rf node_modules spa/node_modules \
    && mkdir -p storage/framework/{cache,sessions,testing,views} storage/logs \
    && chown -R www-data:www-data storage bootstrap/cache

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["entrypoint.sh"]
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
